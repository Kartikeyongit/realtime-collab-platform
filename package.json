{
  "name": "realtime-collab-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "build:server": "tsc --project tsconfig.server-prod.json",
    "socket-server": "ts-node --project tsconfig.server.json src/server/index.ts",
    "yjs-server": "node server/yjs-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run yjs-server\" \"npm run socket-server\"",
    "start:all": "node server/start.js"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.7.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slider": "^1.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.13.4",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.0",
    "date-fns": "^3.0.6",
    "docx": "^9.6.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "immer": "^10.0.3",
    "jspdf": "^4.2.1",
    "lib0": "^0.2.117",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.3",
    "next": "^14.2.35",
    "next-auth": "^4.24.5",
    "openai": "^6.44.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "tippy.js": "^6.3.7",
    "turndown": "^7.2.4",
    "uuid": "^9.0.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.30",
    "zustand": "^4.4.7"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\",\"moduleResolution\":\"node\"} prisma/seed.ts"
  },
