# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/collab-platform?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-secret-here"

# In production (Render), set these to the same origin as your app URL.
# The proxy in server/proxy.js routes /socket.io/* to Socket.IO and
# other WebSocket connections to Yjs — all on a single port.
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_YJS_URL="ws://localhost:1234"
CORS_ORIGIN="http://localhost:3000"

# AI (Groq)
AI_API_KEY="gsk_your_groq_key_here"
AI_BASE_URL="https://api.groq.com/openai/v1"
